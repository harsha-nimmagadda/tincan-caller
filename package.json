{
  "name": "tincan-caller",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-no-literal-jsx.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "capture-fixtures": "node scripts/capture-sdp-fixtures.ts",
    "build:test": "tsc --noEmit && vite build --mode test",
    "preview:test": "vite preview --mode test --port 4173 --strictPort",
    "generate-pwa-assets": "pwa-assets-generator",
    "check-build": "node scripts/check-build.mjs",
    "relay-smoke": "node scripts/relay-smoke.ts"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "nostr-tools": "2.25.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "ws": "8.22.0"
  }
}
